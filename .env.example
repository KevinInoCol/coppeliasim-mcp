# Host y puerto del add-on "ZMQ remote API" de CoppeliaSim.
# Host and port of CoppeliaSim's "ZMQ remote API" add-on.
COPPELIA_HOST=127.0.0.1
COPPELIA_PUERTO=23000

# Carpeta raíz desde la que se permite cargar escenas .ttt/.xml.
# Si no se define, solo se permite el directorio de trabajo actual.
# Root folder from which .ttt/.xml scenes may be loaded.
# If unset, only the current working directory is allowed.
# COPPELIA_DIRECTORIO_ESCENAS=/ruta/a/tus/escenas

# 1 = solo lectura: deshabilita todas las tools que modifican la escena.
# 1 = read-only: disables every tool that mutates the scene.
COPPELIA_MODO_LECTURA=0
